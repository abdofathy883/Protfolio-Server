@model Application.DTOs.Seo.UpdateSeoDto

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>SeoContent</h4>
<hr />
<form asp-action="Edit">
     <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="Route" class="control-label"></label>
                <input asp-for="Route" class="form-control" />
                <span asp-validation-for="Route" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="Language" class="control-label"></label>
                <select asp-for="Language" class="form-control">
                    <option value="ar">AR</option>
                    <option value="en">En</option>
                </select>
                <span asp-validation-for="Language" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <div class="form-group">
            <label asp-for="Title" class="control-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <div class="form-group">
            <label asp-for="Keywords" class="control-label"></label>
            <input asp-for="Keywords" class="form-control" />
            <span asp-validation-for="Keywords" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="OgTitle" class="control-label"></label>
                <input asp-for="OgTitle" class="form-control" />
                <span asp-validation-for="OgTitle" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="OgDescription" class="control-label"></label>
                <input asp-for="OgDescription" class="form-control" />
                <span asp-validation-for="OgDescription" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="OgImage" class="control-label"></label>
                <input type="file" asp-for="OgImage" class="form-control" />
                <span asp-validation-for="OgImage" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-md-6 mb-3">
            <div class="form-group">
                <label asp-for="CanonicalUrl" class="control-label"></label>
                <input asp-for="CanonicalUrl" class="form-control" />
                <span asp-validation-for="CanonicalUrl" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <div class="form-group">
            <label asp-for="Robots" class="control-label"></label>
            <input asp-for="Robots" class="form-control" />
            <span asp-validation-for="Robots" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
